  "reviews": [
    { "product": "faistof-one", "author": "Arif H.", "rating": 5, "title": "The scroll alone is worth it", "body": "Coming from a three-year-old flagship, the 120Hz LumenCore panel makes everything else feel like a slideshow. Battery genuinely holds a full workday of camera abuse.", "verified": true },
    { "product": "faistof-one", "author": "Nusrat J.", "rating": 5, "title": "Crimson is understated, not loud", "body": "Expected a gaming-red phone; got a deep automotive oxblood that catches light only when it wants to. Camera at night is absurd.", "verified": true },
    { "product": "faistof-one", "author": "Tanvir R.", "rating": 4, "title": "Excellent, with one wish", "body": "Performance and thermals under Genshin are class-leading. Wish the always-on display had more watch-face-style options. Charging 0-100 in my measured 26 minutes.", "verified": false },
    { "product": "faistof-one", "author": "Sadia K.", "rating": 5, "title": "Zoom that earns its island", "body": "3× periscope prints A4 at night. The AI erase in gallery is scary good — removed a whole construction site from a rooftop shot.", "verified": true },
    { "product": "faistof-one-pro", "author": "Imran A.", "rating": 5, "title": "The 1-inch sensor is not marketing", "body": "Low-light video has real dynamic range, and LOG grading held up without banding. 213g feels balanced because the mass is spread well.", "verified": true },
    { "product": "faistof-one-pro", "author": "Rifat M.", "rating": 4, "title": "Near perfect shooter", "body": "Shutter lag fixed in last firmware. Wish wireless charging matched the wired speed, but 120W in 19 minutes makes up for it.", "verified": false },
    { "product": "faistof-one-ultra", "author": "Farhana Q.", "rating": 5, "title": "Jewellery that makes calls", "body": "The ceramic laminate back and raw titanium edge are the most premium materials I have held. Numbered edition plate is a nice touch.", "verified": true },
    { "product": "faistof-one-ultra", "author": "Zayan C.", "rating": 5, "title": "5x periscope changes how I shoot", "body": "Candid street photography without approaching anyone. 200× is a novelty but the 5x is daily-driver real.", "verified": true },
    { "product": "faistof-lite", "author": "Mehedi S.", "rating": 4, "title": "Flagship manners, honest price", "body": "Same design language as the ONE at half the money. Camera is very good, not ultra-good — exactly what the price promises.", "verified": true },
    { "product": "faistof-lite", "author": "Tasnim A.", "rating": 5, "title": "Perfect daily for family", "body": "Bought two. 67W charging, clean software, no ads. Halo AI summarizer works even on the 8GB model.", "verified": false },
    { "product": "faistof-watch", "author": "Rakib U.", "rating": 5, "title": "Two-week thing is real", "body": "Day 11 at 22% with always-on disabled and daily training. Sapphire face has zero scratches after three months of desk abuse.", "verified": true },
    { "product": "faistof-buds", "author": "Anika R.", "rating": 5, "title": "ANC for Dhaka traffic", "body": "Bus and construction noise simply leaves. Transparency mode is natural enough to keep for conversations.", "verified": true },
    { "product": "faistof-buds", "author": "Shahriar K.", "rating": 4, "title": "Great sound, wish for multipoint", "body": "LDAC with the ONE is excellent. Multipoint between laptop and phone arrived in firmware — works fine now.", "verified": false },
    { "product": "faistof-charge", "author": "Sabrina H.", "rating": 5, "title": "Smaller than I believed", "body": "Full HyperCharge speed from a brick the size of a matchbox and it stays cool. Travel charger for life.", "verified": true },
    { "product": "faistof-case", "author": "Nafis T.", "rating": 4, "title": "Aramid that looks expensive", "body": "The weave direction catches light exactly like the campaign photos. Two drops survived without a mark. Slim to install though.", "verified": true },
    { "product": "faistof-power", "author": "Ghazi M.", "rating": 5, "title": "Load-shedding insurance", "body": "Two full phone charges plus a laptop top-up. The LumenRead display is nerdy perfection.", "verified": true }
  ],
